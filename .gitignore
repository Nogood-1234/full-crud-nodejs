# Dependency directories
node_modules/
jspm_packages/

# Lockfiles (As requested - note: usually kept for apps, but excluded here)
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# Environment variables and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Diagnostic reports (Next.js / Node.js)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented code coverage downloads
.nyc_output
coverage/
.component_cache/

# Build outputs (if using TypeScript or bundlers)
dist/
build/
.next/
.out/

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db